# Server Configuration
PORT=3000
NODE_ENV=development

# Daily Renewal Cron Schedule (Default: Every day at 7:00 AM)
DAILY_RENEWAL_CRON=0 7 * * *

# Email Notification Settings
SUBSCRIBER_EMAIL=ananya@example.com
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=test@ethereal.email
SMTP_PASS=secretpassword
SMTP_SECURE=false

# Simulation Mode: if true, uses Ethereal test mailer or generates direct preview links
SIMULATION_MODE=true
